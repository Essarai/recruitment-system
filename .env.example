MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=railway
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_CA_FILE=server/certs/mysql-ca.pem
MYSQL_SSL_VERIFY_IDENTITY=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET=recruitment-resumes-20261017
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=管理员
INITIAL_ADMIN_PASSWORD=
API_PORT=3001
API_HOST=127.0.0.1
# Set NODE_ENV=production, API_HOST=0.0.0.0 and COOKIE_SECURE=true when serving HTTPS on Railway.
COOKIE_SECURE=false

# Local: http://localhost:4173; Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_ORIGIN=http://localhost:4173
NODE_ENV=development

# Feishu: credentials stay server-side; binding uses the existing recruitment login.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=http://localhost:4173/api/feishu/bind/callback
# Optional tenant pin and single-account pilot. When empty, use the administrator-selected sync scope.
FEISHU_TENANT_KEY=
FEISHU_PILOT_USER_ID=
# Optional encrypted event callback; polling works without these.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
